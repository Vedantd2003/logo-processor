# ── Required ──────────────────────────────────────────────────────────────────
RECIPIENT_EMAIL=evaluator@example.com

# Email provider: "smtp", "resend", or "brevo"
EMAIL_PROVIDER=smtp

# ── SMTP / Gmail ───────────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASSWORD=xxxx-xxxx-xxxx-xxxx   # Gmail App Password

# ── Resend (free tier — sends only to account owner email) ────────────────────
RESEND_API_KEY=
RESEND_FROM=onboarding@resend.dev

# ── Brevo / Sendinblue (recommended for cloud — works from any IP) ────────────
BREVO_LOGIN=your-brevo-account@email.com
BREVO_SMTP_KEY=                      # Brevo SMTP key (not your account password)

# ── App ────────────────────────────────────────────────────────────────────────
MAX_UPLOAD_MB=5
LOG_LEVEL=INFO
